# ─────────────────────────────────────────────────────────────
# TestPilot PW — environment configuration
# Copy to .env and adjust. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# System under test (defaults point to the hosted workshop deployment)
UI_BASE_URL=https://taskpilot-web.onrender.com
API_BASE_URL=https://taskpilot-api-k11v.onrender.com
# Local alternative:
# UI_BASE_URL=http://localhost:5173
# API_BASE_URL=http://localhost:8000

# Max seconds to wait for /health before running tests (Render free tier may cold-start)
HEALTH_TIMEOUT_SECONDS=120

# Evidence level: "standard" (on failure) or "full" (screenshots/video/trace for every test)
EVIDENCE=standard

# Parallel workers (keep low: the workshop database is shared)
WORKERS=3

# ── Jira (optional) ──────────────────────────────────────────
# fixture   = read sample stories from data/jira/*.json (no network)
# connected = call Jira Cloud REST API v3 with the credentials below
JIRA_MODE=fixture
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
# Publishing is double-gated: this flag AND the --approve CLI argument are both required
JIRA_PUBLISH_ENABLED=false

# ── CI metadata (set automatically in GitHub Actions) ───────
# GITHUB_SHA=
# GITHUB_RUN_ID=
# GITHUB_SERVER_URL=https://github.com
# GITHUB_REPOSITORY=owner/repo
