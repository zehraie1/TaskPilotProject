  "fields": {
    "summary": "Delete a task",
    "issuetype": {
      "name": "Story"
    },
    "status": {
      "name": "Ready for QA"
    },
    "priority": {
      "name": "Medium"
    },
    "labels": [
      "taskpilot",
      "delete"
    ],
    "project": {
      "key": "TP",
      "name": "TaskPilot"
    },
    "description": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "User story"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "As a team member, I want to delete tasks that are no longer needed so that the task list stays relevant."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "Acceptance Criteria"
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC1: Deleting a task asks for confirmation; if I cancel, the task is kept."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC2: After I confirm, the task is removed from the list and can no longer be retrieved."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC3: Deleting a task that does not exist returns a \"not found\" error."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
