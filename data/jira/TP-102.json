{
  "id": "10102",
  "key": "TP-102",
  "self": "https://example.atlassian.net/rest/api/3/issue/10102",
  "fields": {
    "summary": "Find and view tasks",
    "issuetype": {
      "name": "Story"
    },
    "status": {
      "name": "Ready for QA"
    },
    "priority": {
      "name": "High"
    },
    "labels": [
      "taskpilot",
      "search"
    ],
    "project": {
      "key": "TP",
      "name": "TaskPilot"
    },
    "description": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "User story"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "As a team member, I want to search, filter and page through tasks and open a task so that I can quickly find the work I care about."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "Acceptance Criteria"
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC1: When I search, only tasks whose title or description contains the search text are listed."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC2: When I filter by status, only tasks with that status are listed."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC3: When no task matches my search or filter, a \"No matching tasks\" empty state is shown."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC4: The list is paginated; the page size must be between 1 and 100 and invalid page sizes are rejected."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC5: When I open a task, its title, description, status, priority, due date, id and timestamps are displayed."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
