{
  "id": "10101",
  "key": "TP-101",
  "self": "https://example.atlassian.net/rest/api/3/issue/10101",
  "fields": {
    "summary": "Create a task",
    "issuetype": {
      "name": "Story"
    },
    "status": {
      "name": "Ready for QA"
    },
    "priority": {
      "name": "High"
    },
    "labels": [
      "taskpilot",
      "create"
    ],
    "project": {
      "key": "TP",
      "name": "TaskPilot"
    },
    "description": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "User story"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "As a team member, I want to create a task with a title, description, status, priority and due date so that I can capture work that needs to be done."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "Acceptance Criteria"
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC1: Given I provide a valid title, when I create a task, then it is saved with a unique id, status \"pending\" and priority \"medium\" unless I choose otherwise."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC2: The title is required and must be between 1 and 120 characters; a missing, empty or too-long title is rejected with a validation error and no task is created."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC3: Description (up to 2000 characters), status, priority and due date are optional, and the values I enter are saved exactly as entered; invalid values are rejected."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC4: A newly created task immediately appears in the task list."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "Notes"
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Out of scope: attachments, assignees."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
