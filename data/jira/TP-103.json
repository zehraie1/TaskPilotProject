{
  "id": "10103",
  "key": "TP-103",
  "self": "https://example.atlassian.net/rest/api/3/issue/10103",
  "fields": {
    "summary": "Update a task and track progress",
    "issuetype": {
      "name": "Story"
    },
    "status": {
      "name": "Ready for QA"
    },
    "priority": {
      "name": "High"
    },
    "labels": [
      "taskpilot",
      "update"
    ],
    "project": {
      "key": "TP",
      "name": "TaskPilot"
    },
    "description": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "User story"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "As a team member, I want to edit tasks and move them through pending, in progress and completed so that the team always sees the real state of work."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "Acceptance Criteria"
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC1: I can edit the title, description, priority and due date of an existing task and the changes are saved."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC2: I can change the status of a task from the task list or the task details page, and the new status is saved and displayed."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC3: Invalid updates (empty title, unknown status, non-existent task) are rejected and the task remains unchanged."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC4: Every successful update refreshes the task's \"updated\" timestamp."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
