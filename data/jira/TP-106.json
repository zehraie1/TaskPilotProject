      "resilience"
    ],
    "project": {
      "key": "TP",
      "name": "TaskPilot"
    },
    "description": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "User story"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "As a user, I want clear feedback while data loads and when the service is unavailable so that I am never left looking at a blank screen."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "Acceptance Criteria"
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC1: While tasks are loading, a \"Loading tasks…\" indicator is shown."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "AC2: When the API cannot be reached, a clear error message and a \"Try again\" action are shown."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
